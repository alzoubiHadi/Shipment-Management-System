<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for the app to open any network connection at all. Without
         this, Android blocks socket creation at the OS level with
         "SocketException: Operation not permitted, errno = 1" — this is the
         exact error seen in the release build. The debug manifest
         (android/app/src/debug/AndroidManifest.xml) already had this
         permission for Flutter's own tooling needs, which is why this never
         showed up in `flutter run` (debug), only in the release APK. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Driver GPS location sharing (UC-21/UC-14). COARSE is requested
         alongside FINE because Android may grant only the
         approximate-location permission depending on the user's choice in
         the permission dialog. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Background trip tracking (2026-08-24, DriverLocationReporter.dart):
         only requested/used while a driver has an active trip (Shipment
         status 1/2/5) — see the reporter's docblock. ACCESS_BACKGROUND_LOCATION
         is what lets Android grant location access once the app is no
         longer in the foreground (Android 10+ requirement); the
         FOREGROUND_SERVICE* permissions are what let geolocator run its
         persistent-notification foreground service that keeps the app
         process (and thus location reporting) alive with the screen off
         or another app in front (Android 14+ requires the *_LOCATION
         variant specifically for a location-type foreground service). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Proof-of-delivery photo capture (2026-08-25, PodAttachmentPage.dart,
         image_picker): most devices launch the system camera app via an
         implicit intent with no permission needed, but some OEM builds
         still require CAMERA declared to grant that intent. Not
         "required" so the app still installs on a device with no camera —
         file upload remains available as the other attachment option. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="FMS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false">
        <!-- 2026-08-28: baseUrl (config.dart) now points at the deployed
             HTTPS backend (Render), so plain-HTTP is no longer needed —
             cleartext traffic is disabled. Only re-enable this if a local
             LAN "http://<IP>:8000/api" dev backend is used again. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required by url_launcher (CompanyDetailsPage's "View Trade
             License" button) to open https:// links in an external browser
             on Android 11+, which hides package visibility by default. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
